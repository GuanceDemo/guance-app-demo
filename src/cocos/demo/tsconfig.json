{
  "extends": "./temp/tsconfig.cocos.json",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2020",
      "DOM"
    ],
    "paths": {
      "db://assets/*": [
        "./assets/*"
      ],
      "db://internal/default_renderpipeline/builtin-dof-pass": [
        "./types/cocos-internal.d.ts"
      ]
    }
  },
  "include": [
    "assets/**/*.ts"
  ]
}
