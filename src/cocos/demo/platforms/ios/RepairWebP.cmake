# Creator 3.8.8's universal WebP archive has misaligned 64-bit slice offsets.
# Reassemble its unchanged slices locally for current Xcode linkers.
if(NOT CMAKE_HOST_APPLE OR NOT TARGET webp)
    return()
endif()

get_target_property(DEMO_WEBP_SOURCE webp IMPORTED_LOCATION)
execute_process(COMMAND xcrun lipo -info "${DEMO_WEBP_SOURCE}"
    OUTPUT_VARIABLE DEMO_WEBP_ARCHS RESULT_VARIABLE DEMO_WEBP_RESULT
    OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT DEMO_WEBP_RESULT EQUAL 0)
    message(FATAL_ERROR "Cannot inspect Creator's WebP archive")
endif()
if(DEMO_WEBP_ARCHS MATCHES "are: ([^\r\n]+)")
    set(DEMO_WEBP_ARCHS "${CMAKE_MATCH_1}")
elseif(DEMO_WEBP_ARCHS MATCHES "is architecture:")
    return()
else()
    message(FATAL_ERROR "Cannot determine Creator's WebP architectures")
endif()
separate_arguments(DEMO_WEBP_ARCHS UNIX_COMMAND "${DEMO_WEBP_ARCHS}")
list(LENGTH DEMO_WEBP_ARCHS DEMO_WEBP_ARCH_COUNT)
if(DEMO_WEBP_ARCH_COUNT LESS 2)
    return()
endif()

set(DEMO_WEBP_DIR "${CMAKE_CURRENT_BINARY_DIR}/demo-webp")
file(MAKE_DIRECTORY "${DEMO_WEBP_DIR}")
set(DEMO_WEBP_SLICES)
set(DEMO_WEBP_ALIGNMENTS)
foreach(DEMO_WEBP_ARCH IN LISTS DEMO_WEBP_ARCHS)
    set(DEMO_WEBP_SLICE "${DEMO_WEBP_DIR}/${DEMO_WEBP_ARCH}.a")
    execute_process(COMMAND xcrun lipo "${DEMO_WEBP_SOURCE}" -thin "${DEMO_WEBP_ARCH}"
        -output "${DEMO_WEBP_SLICE}" RESULT_VARIABLE DEMO_WEBP_RESULT)
    if(NOT DEMO_WEBP_RESULT EQUAL 0)
        message(FATAL_ERROR "Cannot extract Creator's WebP ${DEMO_WEBP_ARCH} slice")
    endif()
    list(APPEND DEMO_WEBP_SLICES "${DEMO_WEBP_SLICE}")
    if(DEMO_WEBP_ARCH MATCHES "^(arm64|arm64e|x86_64)$")
        list(APPEND DEMO_WEBP_ALIGNMENTS -segalign "${DEMO_WEBP_ARCH}" 0x8)
    endif()
endforeach()
set(DEMO_WEBP_ALIGNED "${DEMO_WEBP_DIR}/libwebp.a")
execute_process(COMMAND xcrun lipo -create ${DEMO_WEBP_SLICES} ${DEMO_WEBP_ALIGNMENTS}
    -output "${DEMO_WEBP_ALIGNED}" RESULT_VARIABLE DEMO_WEBP_RESULT)
if(NOT DEMO_WEBP_RESULT EQUAL 0)
    message(FATAL_ERROR "Cannot align Creator's WebP archive")
endif()
set_target_properties(webp PROPERTIES IMPORTED_LOCATION "${DEMO_WEBP_ALIGNED}")
