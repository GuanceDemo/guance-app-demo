<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/AppTheme.Toolbar"
            app:popupTheme="@style/AppTheme.Toolbar" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/websocket_test_intro"
                android:textColor="#666666"
                android:textSize="14sp" />

            <Button
                android:id="@+id/websocket_success_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/websocket_test_success" />

            <Button
                android:id="@+id/websocket_reject_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/websocket_test_reject" />

            <Button
                android:id="@+id/websocket_invalid_upgrade_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/websocket_test_invalid_upgrade" />

            <Button
                android:id="@+id/websocket_close_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/websocket_test_close" />

            <TextView
                android:id="@+id/websocket_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
